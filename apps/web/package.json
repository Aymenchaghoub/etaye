{
  "name": "etaye-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 ../../tools/generate_web_tokens.py --target-dir .cache/design && vite",
    "build": "node scripts/generate-api.mjs --check && node scripts/check-web-dependencies.mjs && tsc -b && python3 ../../tools/generate_web_tokens.py --target-dir .cache/design && vite build && node -e \"const { copyFileSync } = require('node:fs'); copyFileSync('../../docs/references/hey-api-license.md', 'dist/hey-api-license.md'); copyFileSync('../../design/received/2026-11-03/licenses/Lucide-LICENSE.txt', 'dist/Lucide-LICENSE.txt')\"",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:e2e-real": "playwright test --config=playwright.real.config.ts",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "lint": "eslint . --no-inline-config --max-warnings 0",
    "lint:prune": "eslint . --prune-suppressions",
    "verify": "pnpm lint && pnpm check:api && tsc -b && pnpm test:coverage"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
