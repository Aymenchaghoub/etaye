# Étaye local infrastructure environment variables
# Copy to .env for local docker-compose usage. Never commit .env with real credentials.

POSTGRES_DB=etaye
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_with_local_admin_password

ETAYE_OWNER_USER=etaye_owner
ETAYE_OWNER_PASSWORD=replace_with_local_owner_password

ETAYE_RUNTIME_USER=etaye_runtime
ETAYE_RUNTIME_PASSWORD=replace_with_local_runtime_password

ETAYE_IDENTITY_USER=etaye_identity
ETAYE_IDENTITY_PASSWORD=replace_with_local_identity_password
