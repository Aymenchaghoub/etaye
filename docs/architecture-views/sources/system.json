  "cards": [
    {
      "dot": "cyan",
      "title": "Planning snapshot — 19 Nov 2026",
      "items": [
        "User decisions: Spring Boot, React TypeScript, PostgreSQL; isolated practices; patient-first native app (React Native with Expo, demo-only).",
        "The modular monolith and most tooling remain documented proposals (ADR-001–007). ADR-008, ADR-009 and ADR-010 are accepted. Nothing here is an implemented runtime."
      ]
    },
    {
      "dot": "emerald",
      "title": "Core journey",
      "items": [
        "Record + dated sources → deterministic clinician brief → encounter → report / separate explanation → human review → explicit patient publication.",
        "The brief stays DRAFT and is acknowledged only. Validation never publishes. See the documents view for the actual gates."
      ]
    },
    {
      "dot": "rose",
      "title": "Every boundary stays scoped",
      "items": [
        "Current capability plus practice and record ownership on queries, mutations, jobs, sources, files and exports. Administrator does not imply clinical access.",
        "If-Match, idempotency, database overlap constraints, audit and outbox protect state changes. Provider calls run outside the originating transaction."
      ]
    },
    {
      "dot": "amber",
      "title": "Phased target, not an increment-1 inventory",
      "items": [
        "I1: web journey, seeded slots/document, deterministic adapters, P-03 PDF. I2: complete web entry/upload/scheduling/admin and P-01/P-02. I3: PWA → Android app (Expo) + push. I4: iOS demo gate and conditional release extensions.",
        "No required broker, Redis, microservices or vector database. Object storage and real antivirus scanning are deferred; hosting and exact dependency versions remain gated."
      ]
    }
  ]
