# Keep the editable design tracker consistent with committed-diff checks.
docs/design/coverage.csv text eol=lf
docs/design/html-reception.csv text eol=lf
# Preserve original Figma export bytes used by the provenance manifest.
docs/design/figma/assets/*.svg -text
# Byte-exact third-party receipt; provenance is checked before reconstruction.
design/received/2026-11-03/** -text
design/received/2026-11-03/gen/overflow_check.py -whitespace
design/received/2026-11-03/gen/screens_brief.py -whitespace
design/received/2026-11-03/licenses/Atkinson-Mono-OFL.txt -whitespace
design/received/2026-11-03/licenses/Atkinson-Next-OFL.txt -whitespace
design/received/2026-11-03/receipt/claude-html-design-progress.csv whitespace=cr-at-eol
# Preserve the checked Archify HTML and the original SVG export byte for byte.
docs/architecture-views/site/access.html -text -diff -whitespace
docs/architecture-views/site/delivery.html -text -diff -whitespace
docs/architecture-views/site/documents.html -text -diff -whitespace
docs/architecture-views/site/modules.html -text -diff -whitespace
docs/architecture-views/site/system.html -text -diff -whitespace
docs/architecture-views/overview.svg -text -diff -whitespace
# Preserve the frozen mockup bytes across platforms and collapse generated diffs.
design/offline-reference/site/** -text -diff -whitespace linguist-generated=true
design/offline-reference/snapshot.json text eol=lf

# Maven wrapper batch script on Windows
apps/api/mvnw.cmd text eol=crlf whitespace=cr-at-eol
